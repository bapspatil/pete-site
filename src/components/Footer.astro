---
---
<footer class="relative border-t-4 border-[var(--color-moss)] mt-16">
  <div class="max-w-6xl mx-auto px-6 py-14 grid gap-10 md:grid-cols-[1.3fr_1fr_1fr]">
    <div>
      <div class="flex items-center gap-3">
        <span class="inline-block w-10 h-10 bg-[var(--color-gold)] border-2 border-[var(--color-cream)]">
          <svg viewBox="0 0 8 8" class="w-full h-full" shape-rendering="crispEdges" aria-hidden="true">
            <rect x="3" y="0" width="2" height="1" fill="#c43a2a" />
            <rect x="2" y="1" width="4" height="1" fill="#c43a2a" />
            <rect x="1" y="2" width="6" height="1" fill="#f3d1a6" />
            <rect x="2" y="3" width="1" height="1" fill="#14261c" />
            <rect x="5" y="3" width="1" height="1" fill="#14261c" />
            <rect x="2" y="5" width="4" height="1" fill="#2f5c44" />
            <rect x="1" y="6" width="6" height="1" fill="#2f5c44" />
            <rect x="1" y="7" width="2" height="1" fill="#14261c" />
            <rect x="5" y="7" width="2" height="1" fill="#14261c" />
          </svg>
        </span>
        <span class="font-pixel text-sm tracking-widest text-[var(--color-cream)]">PETE</span>
      </div>
      <p class="font-retro text-lg text-[var(--color-cream)]/70 mt-4 max-w-sm leading-snug">
        People for Ethical Treatment of Elves. A satirical nonprofit parody. No elves — or humans — were
        harmed in the making of this site.
      </p>
    </div>

    <div>
      <div class="font-pixel text-[11px] text-[var(--color-gold)] mb-4">EXPLORE</div>
      <ul class="font-retro text-lg text-[var(--color-cream)]/80 space-y-2">
        <li><a href="#crisis" class="hover:text-[var(--color-gold)]">The Crisis</a></li>
        <li><a href="#why" class="hover:text-[var(--color-gold)]">Why Elves Matter</a></li>
        <li><a href="#help" class="hover:text-[var(--color-gold)]">Take Action</a></li>
        <li><a href="#voices" class="hover:text-[var(--color-gold)]">Voices</a></li>
      </ul>
    </div>

    <div>
      <div class="font-pixel text-[11px] text-[var(--color-gold)] mb-4">LEGAL-ISH</div>
      <ul class="font-retro text-lg text-[var(--color-cream)]/80 space-y-2">
        <li><a href="#" class="hover:text-[var(--color-gold)]">Privacy Policy (Fictional)</a></li>
        <li><a href="#" class="hover:text-[var(--color-gold)]">Cookie Policy (Literal)</a></li>
        <li><a href="#" class="hover:text-[var(--color-gold)]">Press Kit</a></li>
        <li><a href="mailto:hello@thisispete.org" class="hover:text-[var(--color-gold)]">hello@thisispete.org</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t-2 border-dashed border-[var(--color-moss)]">
    <div class="max-w-6xl mx-auto px-6 py-6 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="font-retro text-lg text-[var(--color-cream)]/70">
        Built by
        <a
          href="https://www.bapspatil.com"
          target="_blank"
          rel="noopener noreferrer"
          class="text-[var(--color-gold)] hover:text-[var(--color-leaf)] underline underline-offset-4 decoration-dotted"
        >Bapusaheb Patil</a>
        &nbsp;&copy; 2026
      </p>
      <p class="font-pixel text-[10px] tracking-widest text-[var(--color-cream)]/50">
        PARODY SITE • NOT AFFILIATED WITH ANY NORTHERN OPERATION
      </p>
    </div>
  </div>
</footer>
