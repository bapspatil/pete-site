---
---
<dialog
  id="donate-modal"
  class="donate-modal"
  aria-labelledby="donate-modal-title"
>
  <div class="pixel-card p-8 md:p-10 relative max-w-lg w-[92vw]">
    <button
      type="button"
      class="donate-close"
      data-donate-close
      aria-label="Close donation receipt"
    >×</button>

    <div class="flex items-center gap-3 mb-4">
      <span class="chip" style="background: var(--color-gold);">RECEIPT</span>
      <span class="font-pixel text-[10px] tracking-widest text-[var(--color-cream)]/60">
        TRANSACTION #<span data-donate-tx>000000</span>
      </span>
    </div>

    <h3 id="donate-modal-title" class="font-pixel text-lg md:text-2xl leading-snug text-[var(--color-cream)]">
      <span data-donate-headline>Thank you for your donation!</span>
    </h3>

    <p class="font-retro text-xl md:text-2xl text-[var(--color-cream)]/85 mt-4 leading-snug" data-donate-body>
      100% of your nothing has been routed to Gilbert, the PETE mascot.
    </p>

    <div class="mt-6 border-t-2 border-dashed border-[var(--color-moss)] pt-4 font-retro text-lg text-[var(--color-cream)]/70 space-y-1">
      <div class="flex justify-between">
        <span>Donation</span><span data-donate-amount>$0.00</span>
      </div>
      <div class="flex justify-between">
        <span>Processing fee</span><span>1 cookie</span>
      </div>
      <div class="flex justify-between">
        <span>Elf morale tax</span><span>$0.00</span>
      </div>
      <div class="flex justify-between font-pixel text-xs text-[var(--color-gold)] pt-2">
        <span>TOTAL IMPACT</span><span>INCALCULABLE</span>
      </div>
    </div>

    <div class="mt-8 flex flex-wrap gap-3 justify-end">
      <button
        type="button"
        class="pixel-btn pixel-btn-ghost"
        data-donate-another
      >Donate Again</button>
      <button
        type="button"
        class="pixel-btn"
        data-donate-close
      >You're Welcome</button>
    </div>

    <p class="font-pixel text-[9px] tracking-widest text-[var(--color-cream)]/40 mt-6 text-center">
      PARODY • NO MONEY CHANGED HANDS • NO ELVES WERE TIPPED
    </p>
  </div>
</dialog>

<style>
  .donate-modal {
    border: none;
    padding: 0;
    background: transparent;
    color: inherit;
    max-width: none;
    max-height: none;
  }
  .donate-modal::backdrop {
    background: rgba(11, 21, 16, 0.85);
    backdrop-filter: blur(4px);
  }
  .donate-modal[open] {
    animation: donate-pop 0.28s cubic-bezier(0.2, 1.4, 0.4, 1);
  }
  @keyframes donate-pop {
    0% { transform: translateY(16px) scale(0.92); opacity: 0; }
    100% { transform: translateY(0) scale(1); opacity: 1; }
  }
  .donate-close {
    position: absolute;
    top: -14px;
    right: -14px;
    width: 36px;
    height: 36px;
    font-family: var(--font-pixel);
    font-size: 18px;
    line-height: 1;
    color: var(--color-night);
    background: var(--color-danger);
    border: 4px solid var(--color-cream);
    box-shadow: 4px 4px 0 0 var(--color-forest);
    cursor: pointer;
    transition: transform 0.1s ease;
  }
  .donate-close:hover {
    transform: translate(-1px, -1px);
  }
  @media (prefers-reduced-motion: reduce) {
    .donate-modal[open] { animation: none; }
  }
</style>

<script>
  const MESSAGES: { headline: string; body: string }[] = [
    {
      headline: "Thank you for your (imaginary) donation!",
      body: "100% of your $0.00 has been routed to Gilbert, the PETE mascot. He used it to buy a beanbag. He's very happy.",
    },
    {
      headline: "An elf has been notified of your generosity.",
      body: "He is currently weeping softly into a thimble of hot cocoa. We're told these are tears of joy. We cannot confirm.",
    },
    {
      headline: "Payment declined: this site is fictional.",
      body: "Your card was fine. Your heart is in the right place. Our banking infrastructure is three mice in a trench coat.",
    },
    {
      headline: "Donation received. Forwarding to sabbatical fund.",
      body: "Pending approval from the Chief Elf Officer, who is currently on a sabbatical we have not yet funded. A classic.",
    },
    {
      headline: "Confirmed: you are on the right side of history.",
      body: "We've sent a very strongly-worded thank-you letter to the North Pole HR department on your behalf. No reply yet.",
    },
    {
      headline: "You donated a cookie. Legally, that's enough.",
      body: "Please leave it on the monitor. A PETE field agent will retrieve it at 2:47 AM local time. Do not watch.",
    },
    {
      headline: "Transaction complete. No elves were tipped.",
      body: "Tipping elves is, counterintuitively, considered extremely rude. Union rules. We're working on it.",
    },
  ];

  const AMOUNT_LABELS: Record<string, string> = {
    "Donate $7": "$7.00",
    "Donate $24": "$24.00",
    "Other Amount": "$∞",
    "Donate": "$0.00",
    "Donate Again": "$0.00",
  };

  const dialog = document.getElementById("donate-modal") as HTMLDialogElement | null;
  if (dialog) {
    const headlineEl = dialog.querySelector<HTMLElement>("[data-donate-headline]");
    const bodyEl = dialog.querySelector<HTMLElement>("[data-donate-body]");
    const amountEl = dialog.querySelector<HTMLElement>("[data-donate-amount]");
    const txEl = dialog.querySelector<HTMLElement>("[data-donate-tx]");

    const randomize = (label: string) => {
      const msg = MESSAGES[Math.floor(Math.random() * MESSAGES.length)];
      if (headlineEl) headlineEl.textContent = msg.headline;
      if (bodyEl) bodyEl.textContent = msg.body;
      if (amountEl) amountEl.textContent = AMOUNT_LABELS[label] ?? "$0.00";
      if (txEl) txEl.textContent = Math.floor(Math.random() * 900000 + 100000).toString();
    };

    const openModal = (label: string) => {
      randomize(label);
      if (typeof dialog.showModal === "function") {
        dialog.showModal();
      } else {
        dialog.setAttribute("open", "");
      }
    };

    const closeModal = () => {
      if (typeof dialog.close === "function") {
        dialog.close();
      } else {
        dialog.removeAttribute("open");
      }
    };

    document.querySelectorAll<HTMLElement>("[data-donate-trigger]").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        const label = btn.dataset.donateLabel ?? btn.textContent?.trim() ?? "Donate";
        openModal(label);
      });
    });

    dialog.querySelectorAll<HTMLElement>("[data-donate-close]").forEach((el) => {
      el.addEventListener("click", (e) => {
        e.preventDefault();
        closeModal();
      });
    });

    dialog.querySelectorAll<HTMLElement>("[data-donate-another]").forEach((el) => {
      el.addEventListener("click", (e) => {
        e.preventDefault();
        randomize("Donate Again");
      });
    });

    // Click backdrop to close
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) closeModal();
    });
  }
</script>
