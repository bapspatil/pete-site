---
interface Props {
  class?: string;
  ariaLabel?: string;
}
const { class: className = "", ariaLabel } = Astro.props;
// 20x24: pixel-art portrait of Bapusaheb Patil.
// Short black hair, black rectangular glasses, warm brown skin, light stubble,
// white t-shirt with navy collar ring.
---
<svg
  viewBox="0 0 20 24"
  class={className}
  shape-rendering="crispEdges"
  role={ariaLabel ? "img" : undefined}
  aria-label={ariaLabel}
  aria-hidden={ariaLabel ? undefined : "true"}
>
  <!-- photo background -->
  <rect x="0" y="0" width="20" height="24" fill="#f4e8cf" />

  <!-- face base -->
  <rect x="5" y="6" width="11" height="1" fill="#c48a5a" />
  <rect x="4" y="7" width="13" height="1" fill="#c48a5a" />
  <rect x="4" y="8" width="13" height="1" fill="#c48a5a" />
  <rect x="4" y="9" width="13" height="1" fill="#c48a5a" />
  <rect x="4" y="10" width="13" height="1" fill="#c48a5a" />
  <rect x="4" y="11" width="13" height="1" fill="#c48a5a" />
  <rect x="4" y="12" width="12" height="1" fill="#c48a5a" />
  <rect x="5" y="13" width="10" height="1" fill="#c48a5a" />
  <rect x="5" y="14" width="10" height="1" fill="#c48a5a" />
  <rect x="6" y="15" width="8" height="1" fill="#c48a5a" />

  <!-- hair thick -->
  <rect x="4" y="1" width="12" height="1" fill="#14261c" />
  <rect x="3" y="2" width="14" height="1" fill="#14261c" />
  <rect x="3" y="3" width="14" height="1" fill="#14261c" />
  <rect x="3" y="4" width="14" height="1" fill="#14261c" />
  <rect x="3" y="5" width="14" height="1" fill="#14261c" />

  <!-- hair frame over forehead -->
  <rect x="3" y="6" width="2" height="1" fill="#14261c" />
  <rect x="15" y="6" width="2" height="1" fill="#14261c" />
  <rect x="3" y="7" width="1" height="1" fill="#14261c" />
  <rect x="16" y="7" width="1" height="1" fill="#14261c" />

  <!-- hair highlight swept-up on top -->
  <rect x="6" y="1" width="4" height="1" fill="#2a3e30" />
  <rect x="5" y="2" width="4" height="1" fill="#2a3e30" />

  <!-- ears -->
  <rect x="3" y="8" width="1" height="2" fill="#8a5e3c" />
  <rect x="16" y="8" width="1" height="2" fill="#8a5e3c" />

  <!-- eyebrows: rest (row 7) and raised (row 6) -->
  <g data-brows="rest">
    <rect x="5" y="7" width="3" height="1" fill="#14261c" />
    <rect x="12" y="7" width="3" height="1" fill="#14261c" />
  </g>
  <g data-brows="raised">
    <rect x="5" y="6" width="3" height="1" fill="#14261c" />
    <rect x="12" y="6" width="3" height="1" fill="#14261c" />
  </g>

  <!-- glasses top rims -->
  <rect x="4" y="8" width="5" height="1" fill="#0b1510" />
  <rect x="11" y="8" width="5" height="1" fill="#0b1510" />
  <!-- bridge -->
  <rect x="9" y="8" width="2" height="1" fill="#0b1510" />
  <!-- lens sides -->
  <rect x="4" y="9" width="1" height="1" fill="#0b1510" />
  <rect x="8" y="9" width="1" height="1" fill="#0b1510" />
  <rect x="11" y="9" width="1" height="1" fill="#0b1510" />
  <rect x="15" y="9" width="1" height="1" fill="#0b1510" />
  <!-- lens bottom rims -->
  <rect x="4" y="10" width="5" height="1" fill="#0b1510" />
  <rect x="11" y="10" width="5" height="1" fill="#0b1510" />

  <!-- eyes behind glasses -->
  <rect x="6" y="9" width="1" height="1" fill="#14261c" />
  <rect x="13" y="9" width="1" height="1" fill="#14261c" />

  <!-- nose -->
  <rect x="10" y="10" width="1" height="1" fill="#8a5e3c" />
  <rect x="9" y="11" width="2" height="1" fill="#8a5e3c" />

  <!-- full short beard: mustache + cheek/jaw/chin coverage -->
  <rect x="7" y="11" width="6" height="1" fill="#3a2a1e" />
  <rect x="5" y="12" width="3" height="1" fill="#3a2a1e" />
  <rect x="12" y="12" width="4" height="1" fill="#3a2a1e" />
  <rect x="5" y="13" width="10" height="1" fill="#3a2a1e" />
  <rect x="5" y="14" width="10" height="1" fill="#3a2a1e" />
  <rect x="6" y="15" width="8" height="1" fill="#3a2a1e" />
  <!-- beard edge highlights for texture -->
  <rect x="4" y="13" width="1" height="1" fill="#5a4030" />
  <rect x="15" y="13" width="1" height="1" fill="#5a4030" />
  <rect x="5" y="14" width="1" height="1" fill="#5a4030" />
  <rect x="14" y="14" width="1" height="1" fill="#5a4030" />

  <!-- mouth: rest (neutral) and smile (teeth), toggled via PortraitToggle -->
  <g data-mouth="rest">
    <rect x="8" y="12" width="4" height="1" fill="#1e120c" />
  </g>
  <g data-mouth="smile">
    <rect x="7" y="12" width="1" height="1" fill="#14261c" />
    <rect x="8" y="12" width="4" height="1" fill="#f4e8cf" />
    <rect x="12" y="12" width="1" height="1" fill="#14261c" />
  </g>

  <!-- neck -->
  <rect x="7" y="16" width="6" height="1" fill="#8a5e3c" />

  <!-- white t-shirt base -->
  <rect x="4" y="17" width="12" height="1" fill="#e8dcc0" />
  <rect x="3" y="18" width="14" height="1" fill="#e8dcc0" />
  <rect x="2" y="19" width="16" height="1" fill="#e8dcc0" />
  <rect x="1" y="20" width="18" height="1" fill="#e8dcc0" />
  <rect x="0" y="21" width="20" height="1" fill="#e8dcc0" />
  <rect x="0" y="22" width="20" height="1" fill="#e8dcc0" />
  <rect x="0" y="23" width="20" height="1" fill="#e8dcc0" />

  <!-- navy collar ring -->
  <rect x="6" y="17" width="2" height="1" fill="#1e2f45" />
  <rect x="12" y="17" width="2" height="1" fill="#1e2f45" />
  <rect x="5" y="18" width="2" height="1" fill="#1e2f45" />
  <rect x="13" y="18" width="2" height="1" fill="#1e2f45" />

  <!-- neckline skin showing -->
  <rect x="8" y="17" width="4" height="1" fill="#8a5e3c" />
  <rect x="9" y="18" width="2" height="1" fill="#8a5e3c" />
</svg>
