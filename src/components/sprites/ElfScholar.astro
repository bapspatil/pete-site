---
interface Props {
  class?: string;
  ariaLabel?: string;
}
const { class: className = "", ariaLabel } = Astro.props;
// 20x28: robed scholar elf with crown/book, representing cultural importance
---
<svg
  viewBox="0 0 20 28"
  class={className}
  shape-rendering="crispEdges"
  role={ariaLabel ? "img" : undefined}
  aria-label={ariaLabel}
  aria-hidden={ariaLabel ? undefined : "true"}
>
  <!-- crown -->
  <rect x="6" y="0" width="1" height="2" fill="#f2c94c" />
  <rect x="9" y="0" width="1" height="2" fill="#f2c94c" />
  <rect x="10" y="0" width="1" height="2" fill="#f2c94c" />
  <rect x="13" y="0" width="1" height="2" fill="#f2c94c" />
  <rect x="5" y="2" width="10" height="2" fill="#f2c94c" />
  <rect x="7" y="2" width="1" height="1" fill="#d44b3a" />
  <rect x="12" y="2" width="1" height="1" fill="#6dc1d9" />
  <!-- hair -->
  <rect x="5" y="4" width="10" height="1" fill="#e8c48a" />
  <!-- face -->
  <rect x="5" y="5" width="10" height="1" fill="#f3d1a6" />
  <rect x="5" y="6" width="10" height="1" fill="#f3d1a6" />
  <rect x="5" y="7" width="10" height="2" fill="#f3d1a6" />
  <!-- ears -->
  <rect x="4" y="6" width="1" height="2" fill="#f3d1a6" />
  <rect x="15" y="6" width="1" height="2" fill="#f3d1a6" />
  <rect x="3" y="7" width="1" height="1" fill="#f3d1a6" />
  <rect x="16" y="7" width="1" height="1" fill="#f3d1a6" />
  <!-- REST: wise open eyes -->
  <g data-pose="rest">
    <rect x="7" y="7" width="1" height="1" fill="#14261c" />
    <rect x="12" y="7" width="1" height="1" fill="#14261c" />
  </g>
  <!-- ACTIVE: eureka. Eyes widen, the open book gets a page-glow highlight. -->
  <g data-pose="active">
    <rect x="6" y="7" width="2" height="1" fill="#14261c" />
    <rect x="12" y="7" width="2" height="1" fill="#14261c" />
  </g>
  <!-- beard (tiny) -->
  <rect x="8" y="9" width="4" height="1" fill="#f4e8cf" />
  <rect x="9" y="10" width="2" height="1" fill="#f4e8cf" />
  <!-- purple robe -->
  <rect x="4" y="11" width="12" height="1" fill="#4a2f6b" />
  <rect x="3" y="12" width="14" height="1" fill="#4a2f6b" />
  <rect x="2" y="13" width="16" height="1" fill="#4a2f6b" />
  <rect x="2" y="14" width="16" height="1" fill="#6b4ab3" />
  <rect x="2" y="15" width="16" height="1" fill="#4a2f6b" />
  <rect x="2" y="16" width="16" height="1" fill="#4a2f6b" />
  <rect x="2" y="17" width="16" height="1" fill="#4a2f6b" />
  <!-- gold robe trim -->
  <rect x="2" y="18" width="16" height="1" fill="#f2c94c" />
  <!-- book held -->
  <rect x="6" y="14" width="8" height="4" fill="#c43a2a" />
  <rect x="7" y="15" width="6" height="1" fill="#f4e8cf" />
  <rect x="7" y="16" width="6" height="1" fill="#f4e8cf" />
  <rect x="9" y="15" width="2" height="2" fill="#c43a2a" />
  <!-- skirt of robe widening -->
  <rect x="1" y="19" width="18" height="1" fill="#4a2f6b" />
  <rect x="1" y="20" width="18" height="1" fill="#4a2f6b" />
  <rect x="1" y="21" width="18" height="1" fill="#4a2f6b" />
  <rect x="1" y="22" width="18" height="1" fill="#4a2f6b" />
  <rect x="1" y="23" width="18" height="1" fill="#f2c94c" />
  <!-- boots under robe -->
  <rect x="5" y="24" width="3" height="2" fill="#14261c" />
  <rect x="12" y="24" width="3" height="2" fill="#14261c" />
</svg>
