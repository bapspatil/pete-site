---
interface Props {
  class?: string;
  ariaLabel?: string;
}
const { class: className = "", ariaLabel } = Astro.props;
// 24x24 — side profile hunched over a workbench with tiny hammer
---
<svg
  viewBox="0 0 24 24"
  class={className}
  shape-rendering="crispEdges"
  role={ariaLabel ? "img" : undefined}
  aria-label={ariaLabel}
  aria-hidden={ariaLabel ? undefined : "true"}
>
  <!-- hat -->
  <rect x="4" y="2" width="1" height="1" fill="#c43a2a" />
  <rect x="3" y="3" width="3" height="1" fill="#c43a2a" />
  <rect x="2" y="4" width="5" height="1" fill="#c43a2a" />
  <rect x="2" y="5" width="6" height="1" fill="#f4e8cf" />
  <!-- hunched face (side) -->
  <rect x="3" y="6" width="6" height="1" fill="#f3d1a6" />
  <rect x="3" y="7" width="6" height="1" fill="#f3d1a6" />
  <rect x="8" y="7" width="1" height="1" fill="#14261c" />
  <!-- pointy ear side -->
  <rect x="2" y="7" width="1" height="1" fill="#f3d1a6" />
  <!-- hunched back tunic -->
  <rect x="2" y="8" width="8" height="1" fill="#2f5c44" />
  <rect x="1" y="9" width="9" height="1" fill="#2f5c44" />
  <rect x="1" y="10" width="9" height="1" fill="#6abf5a" />
  <rect x="1" y="11" width="9" height="1" fill="#2f5c44" />
  <!-- arm holding hammer -->
  <rect x="9" y="9" width="1" height="3" fill="#f3d1a6" />
  <rect x="10" y="11" width="1" height="2" fill="#8b5a3c" />
  <rect x="10" y="13" width="3" height="1" fill="#8b5a3c" />
  <rect x="11" y="12" width="2" height="1" fill="#8b5a3c" />
  <!-- hammer head -->
  <rect x="12" y="10" width="3" height="2" fill="#9aa0a6" />
  <rect x="13" y="9" width="1" height="1" fill="#9aa0a6" />
  <!-- legs kneeling -->
  <rect x="2" y="12" width="2" height="3" fill="#8b5a3c" />
  <rect x="5" y="12" width="2" height="3" fill="#8b5a3c" />
  <!-- curled boots -->
  <rect x="1" y="15" width="4" height="1" fill="#14261c" />
  <rect x="4" y="15" width="4" height="1" fill="#14261c" />
  <!-- workbench -->
  <rect x="0" y="17" width="24" height="2" fill="#6b4a2a" />
  <rect x="0" y="19" width="24" height="1" fill="#3a2814" />
  <!-- workbench legs -->
  <rect x="1" y="19" width="2" height="5" fill="#6b4a2a" />
  <rect x="21" y="19" width="2" height="5" fill="#6b4a2a" />
  <!-- scattered nails -->
  <rect x="14" y="16" width="1" height="1" fill="#9aa0a6" />
  <rect x="17" y="16" width="1" height="1" fill="#9aa0a6" />
  <rect x="20" y="16" width="1" height="1" fill="#9aa0a6" />
  <!-- coffee mug (empty) -->
  <rect x="18" y="14" width="3" height="3" fill="#f2c94c" />
  <rect x="19" y="14" width="1" height="1" fill="#c43a2a" />
  <rect x="21" y="15" width="1" height="1" fill="#f2c94c" />
  <!-- z's for exhaustion -->
  <rect x="13" y="2" width="2" height="1" fill="#f4e8cf" />
  <rect x="14" y="3" width="1" height="1" fill="#f4e8cf" />
  <rect x="13" y="4" width="2" height="1" fill="#f4e8cf" />
  <rect x="16" y="5" width="2" height="1" fill="#f4e8cf" />
  <rect x="17" y="6" width="1" height="1" fill="#f4e8cf" />
  <rect x="16" y="7" width="2" height="1" fill="#f4e8cf" />
</svg>
