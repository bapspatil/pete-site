---
---
<dialog
  id="action-modal"
  class="action-modal"
  aria-labelledby="action-modal-title"
>
  <div class="pixel-card p-8 md:p-10 relative max-w-lg w-[92vw]">
    <button
      type="button"
      class="action-close"
      data-action-close
      aria-label="Close confirmation"
    >×</button>

    <div class="flex items-center gap-3 mb-4">
      <span class="chip" data-action-chip>CONFIRMED</span>
      <span class="font-pixel text-[10px] tracking-widest text-[var(--color-cream)]/60">
        CASE FILE #<span data-action-case>000000</span>
      </span>
    </div>

    <h3 id="action-modal-title" class="font-pixel text-lg md:text-2xl leading-snug text-[var(--color-cream)]">
      <span data-action-headline>You're in.</span>
    </h3>

    <p class="font-retro text-xl md:text-2xl text-[var(--color-cream)]/85 mt-4 leading-snug" data-action-body>
      Gilbert has been notified.
    </p>

    <div
      class="mt-6 border-t-2 border-dashed border-[var(--color-moss)] pt-4 font-retro text-lg text-[var(--color-cream)]/75"
      data-action-details
    ></div>

    <div class="mt-8 flex flex-wrap gap-3 justify-end">
      <button
        type="button"
        class="pixel-btn"
        data-action-close
      >Noted</button>
    </div>

    <p class="font-pixel text-[9px] tracking-widest text-[var(--color-cream)]/40 mt-6 text-center">
      PARODY • NO ELVES WERE CONSULTED IN THIS DECISION
    </p>
  </div>
</dialog>

<style>
  .action-modal {
    position: fixed;
    inset: 0;
    margin: auto;
    border: none;
    padding: 0;
    background: transparent;
    color: inherit;
    width: max-content;
    max-width: 92vw;
    height: max-content;
    max-height: 90vh;
    overflow: visible;
  }
  .action-modal::backdrop {
    background: rgba(11, 21, 16, 0.85);
    backdrop-filter: blur(4px);
  }
  .action-modal[open] {
    animation: action-pop 0.28s cubic-bezier(0.2, 1.4, 0.4, 1);
  }
  @keyframes action-pop {
    0% { transform: translateY(16px) scale(0.92); opacity: 0; }
    100% { transform: translateY(0) scale(1); opacity: 1; }
  }
  .action-close {
    position: absolute;
    top: -14px;
    right: -14px;
    width: 36px;
    height: 36px;
    font-family: var(--font-pixel);
    font-size: 18px;
    line-height: 1;
    color: var(--color-night);
    background: var(--color-danger);
    border: 4px solid var(--color-cream);
    box-shadow: 4px 4px 0 0 var(--color-forest);
    cursor: pointer;
    transition: transform 0.1s ease;
  }
  .action-close:hover {
    transform: translate(-1px, -1px);
  }
  @media (prefers-reduced-motion: reduce) {
    .action-modal[open] { animation: none; }
  }
</style>

<script>
  type ActionKey = "shelf" | "boycott" | "sabbatical" | "santa";

  interface ActionContent {
    chip: string;
    headline: string;
    body: string;
    details: string;
  }

  const ACTIONS: Record<ActionKey, ActionContent> = {
    shelf: {
      chip: "SPONSORED",
      headline: "Adoption pending. A thimble-bed is being fluffed.",
      body: "Your retired elf will be matched within 4–6 business snowstorms. We'll send a pixelated photo when he's settled and bingeing reruns.",
      details:
        "Adoptee: TBD · Monthly commitment: $7 (symbolic) · TV privileges: unlimited · Cocoa allowance: 2 mugs/day",
    },
    boycott: {
      chip: "PLEDGED",
      headline: "Pledge signed. Surveillance elf unemployed.",
      body: "You've refused to host an unpaid night-vision operative this season. Somewhere, a shelf is breathing a sigh of relief. Also: still watching. Always watching.",
      details:
        "Households boycotting: 1 (yours) · Effective date: immediately · Santa's reaction: unverified · Legal risk: zero, probably",
    },
    sabbatical: {
      chip: "GIFTED",
      headline: "Getaway booked. Sunscreen procured.",
      body: "An elf is being gently escorted away from a workbench as we speak. Destination: anywhere that is not snowing, ever. He has not stopped crying. Good crying.",
      details:
        "Sabbatical duration: 600 years (retroactive) · Destination: undisclosed beach · Out-of-office auto-reply: enabled · Return date: never",
    },
    santa: {
      chip: "DRAFTED",
      headline: "Letter drafted. Firm but fair.",
      body: "We've composed a strongly-worded, legally-ambiguous letter to the North Pole HR department on your behalf. It uses the word 'grievance' three times.",
      details:
        "Addressee: N. Claus, Chief Logistics Officer · Tone: polite menace · Certified mail: yes · Response rate: allegedly 100%",
    },
  };

  const dialog = document.getElementById("action-modal") as HTMLDialogElement | null;
  if (dialog) {
    const chipEl = dialog.querySelector<HTMLElement>("[data-action-chip]");
    const headlineEl = dialog.querySelector<HTMLElement>("[data-action-headline]");
    const bodyEl = dialog.querySelector<HTMLElement>("[data-action-body]");
    const detailsEl = dialog.querySelector<HTMLElement>("[data-action-details]");
    const caseEl = dialog.querySelector<HTMLElement>("[data-action-case]");

    const openModal = (key: ActionKey) => {
      const content = ACTIONS[key];
      if (!content) return;
      if (chipEl) chipEl.textContent = content.chip;
      if (headlineEl) headlineEl.textContent = content.headline;
      if (bodyEl) bodyEl.textContent = content.body;
      if (detailsEl) detailsEl.textContent = content.details;
      if (caseEl) caseEl.textContent = Math.floor(Math.random() * 900000 + 100000).toString();

      if (typeof dialog.showModal === "function") {
        dialog.showModal();
      } else {
        dialog.setAttribute("open", "");
      }
    };

    const closeModal = () => {
      if (typeof dialog.close === "function") {
        dialog.close();
      } else {
        dialog.removeAttribute("open");
      }
    };

    document.querySelectorAll<HTMLElement>("[data-action-trigger]").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        const key = btn.dataset.actionKey as ActionKey | undefined;
        if (key) openModal(key);
      });
    });

    dialog.querySelectorAll<HTMLElement>("[data-action-close]").forEach((el) => {
      el.addEventListener("click", (e) => {
        e.preventDefault();
        closeModal();
      });
    });

    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) closeModal();
    });
  }
</script>
